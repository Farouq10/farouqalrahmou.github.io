{
  "name": "scientific-library-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test:model": "node --test backend/tests/model.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-scientific-library --only firestore \"node --test backend/tests/rules.test.mjs\"",
    "test": "npm run test:model && npm run test:rules",
    "admin": "node backend/scripts/set-admin.mjs",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.30.1"
  }
}
