rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.siteAdmin == true;
    }

    function validTag(tags, index) {
      return tags.size() <= index ||
        (tags[index] is string && tags[index].size() >= 1 &&
         tags[index].size() <= 40);
    }

    function validEntry(data) {
      return data.keys().hasAll([
          'schemaVersion', 'kind', 'subject', 'status', 'title',
          'summary', 'body', 'url', 'tags', 'ownerUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'kind', 'subject', 'status', 'title',
          'summary', 'body', 'url', 'tags', 'ownerUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.kind in ['note', 'resource', 'project'] &&
        data.subject in [
          'mathematics', 'physics', 'chemistry',
          'engineering', 'computing', 'other'
        ] &&
        data.status in ['draft', 'published', 'archived'] &&
        data.title is string && data.title.size() >= 1 &&
        data.title.size() <= 160 &&
        data.summary is string && data.summary.size() <= 2000 &&
        data.body is string && data.body.size() <= 20000 &&
        data.url is string && data.url.size() <= 2048 &&
        (data.url == '' || data.url.matches('^https://.+')) &&
        data.tags is list && data.tags.size() <= 8 &&
        validTag(data.tags, 0) && validTag(data.tags, 1) &&
        validTag(data.tags, 2) && validTag(data.tags, 3) &&
        validTag(data.tags, 4) && validTag(data.tags, 5) &&
        validTag(data.tags, 6) && validTag(data.tags, 7) &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /libraryEntries/{entryId} {
      // Draft and archived records are never readable publicly.
      allow get: if isAdmin() || resource.data.status == 'published';

      // Firestore rules are NOT filters: the client must query
      // where(status == 'published') and use a limit <= 25.
      allow list: if isAdmin() ||
        (request.query.limit != null &&
         request.query.limit <= 25 &&
         resource.data.status == 'published');

      allow create: if isAdmin() &&
        validEntry(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() &&
        validEntry(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.kind == resource.data.kind &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    function validStudySnapshot(data) {
      return data.keys().hasAll(['schema', 'version', 'session', 'updatedAt']) &&
        data.keys().hasOnly(['schema', 'version', 'session', 'updatedAt']) &&
        data.schema == 1 &&
        data.version is int && data.version >= 1 &&
        data.version <= 10000000 &&
        data.updatedAt == request.time &&
        data.session is map &&
        data.session.keys().hasAll([
          'schema','deckId','manifest','queue','complete',
          'progress','attempts','revision','updatedAt'
        ]) &&
        data.session.keys().hasOnly([
          'schema','deckId','manifest','queue','complete',
          'progress','attempts','revision','updatedAt'
        ]) &&
        data.session.schema == 3 &&
        data.session.deckId is string &&
        data.session.deckId.size() >= 1 &&
        data.session.deckId.size() <= 100 &&
        data.session.queue is list &&
        data.session.complete is list &&
        data.session.queue.size() <= 500 &&
        data.session.complete.size() <= 500 &&
        data.session.manifest is map &&
        data.session.manifest.size() <= 500 &&
        data.session.progress is map &&
        data.session.progress.size() <= 500 &&
        data.session.attempts is int &&
        data.session.attempts >= 0 &&
        data.session.attempts <= 10000000 &&
        data.session.revision is int &&
        data.session.revision >= 0 &&
        data.session.updatedAt is number;
    }

    match /studyProgress/{ownerUid} {
      function owner() {
        return request.auth != null && request.auth.uid == ownerUid;
      }
      // A single private document per Firebase user. No public reads or queries.
      allow get: if owner();
      allow list: if false;
      allow create: if owner() &&
        validStudySnapshot(request.resource.data) &&
        request.resource.data.version == 1;
      allow update: if owner() &&
        validStudySnapshot(request.resource.data) &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.schema == resource.data.schema;
      allow delete: if false;
    }

    // All other collections and documents are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
