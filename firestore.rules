rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.siteAdmin == true;
    }

    function validTag(tags, index) {
      return tags.size() <= index ||
        (tags[index] is string && tags[index].size() >= 1 &&
         tags[index].size() <= 40);
    }

    function validEntry(data) {
      return data.keys().hasAll([
          'schemaVersion', 'kind', 'subject', 'status', 'title',
          'summary', 'body', 'url', 'tags', 'ownerUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'kind', 'subject', 'status', 'title',
          'summary', 'body', 'url', 'tags', 'ownerUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.kind in ['note', 'resource', 'project'] &&
        data.subject in [
          'mathematics', 'physics', 'chemistry',
          'engineering', 'computing', 'other'
        ] &&
        data.status in ['draft', 'published', 'archived'] &&
        data.title is string && data.title.size() >= 1 &&
        data.title.size() <= 160 &&
        data.summary is string && data.summary.size() <= 2000 &&
        data.body is string && data.body.size() <= 20000 &&
        data.url is string && data.url.size() <= 2048 &&
        (data.url == '' || data.url.matches('^https://.+')) &&
        data.tags is list && data.tags.size() <= 8 &&
        validTag(data.tags, 0) && validTag(data.tags, 1) &&
        validTag(data.tags, 2) && validTag(data.tags, 3) &&
        validTag(data.tags, 4) && validTag(data.tags, 5) &&
        validTag(data.tags, 6) && validTag(data.tags, 7) &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /libraryEntries/{entryId} {
      // Draft and archived records are never readable publicly.
      allow get: if isAdmin() || resource.data.status == 'published';

      // Firestore rules are NOT filters: the client must query
      // where(status == 'published') and use a limit <= 25.
      allow list: if isAdmin() ||
        (request.query.limit != null &&
         request.query.limit <= 25 &&
         resource.data.status == 'published');

      allow create: if isAdmin() &&
        validEntry(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() &&
        validEntry(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.kind == resource.data.kind &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // All other collections and documents are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
